<section class="hero-essentia section">
  <div class="container">
    <div class="hero-wrapper">
      <!-- Venstre side: Innhold -->
      <div class="hero-content">
        {% if section.settings.show_badge %}
        <div class="hero-badge">
          <span>{{ section.settings.badge_text | default: 'Premium Air Care' }}</span>
        </div>
        {% endif %}
        
        <h1 class="hero-title">
          {{ section.settings.title | default: "Frisk luft, overalt" }}
        </h1>
        
        <p class="hero-description">
          {{ section.settings.subtitle | default: "Premium luftfriskere designet for moderne hjem og biler. Nordisk kvalitet møter innovativ teknologi." }}
        </p>
        
        <div class="hero-stats">
          <div class="stat-item">
            <div class="stat-number">{{ section.settings.stat1_value | default: "Nylig" }}</div>
            <div class="stat-label">{{ section.settings.stat1_label | default: "Lansert" }}</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">{{ section.settings.stat2_value | default: "2" }}</div>
            <div class="stat-label">{{ section.settings.stat2_label | default: "Bilprodukter" }}</div>
          </div>
          <div class="stat-item">
            <div class="stat-number">{{ section.settings.stat3_value | default: "7" }}</div>
            <div class="stat-label">{{ section.settings.stat3_label | default: "Dufter & refills" }}</div>
          </div>
        </div>

        {% if section.blocks.size > 0 %}
        <div class="hero-chips">
          {% for block in section.blocks %}
            <span class="chip" {{ block.shopify_attributes }}>
              {% if block.settings.icon %}{{ block.settings.icon }}{% endif %}
              {{ block.settings.label }}
            </span>
          {% endfor %}
        </div>
        {% endif %}
        
        <div class="hero-actions">
          <a href="{{ section.settings.primary_link | default: '#product-configurator' }}" class="btn btn-primary btn-lg">
            {{ section.settings.primary_label | default: "Bygg din pakke" }}
          </a>
          <a href="{{ section.settings.secondary_link | default: '/collections/all' }}" class="btn btn-ghost btn-lg">
            {{ section.settings.secondary_label | default: "Se produkter" }}
          </a>
        </div>
      </div>
      
      <!-- Høyre side: Bilde -->
      <div class="hero-media">
        {% if section.settings.product_image %}
          <img src="{{ section.settings.product_image | img_url: '900x' }}" alt="{{ section.settings.title | default: 'Produkt' }}" />
        {% else %}
          <img src="{{ 'Bilde_05.08.2025__19_21_05-removebg-preview.png' | asset_url }}" alt="Produkt" />
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-essentia {
    padding: 60px 0;
    background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 100%);
    position: relative;
    overflow: hidden;
  }
  
  .hero-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    min-height: 500px;
  }
  
  .hero-content {
    max-width: 600px;
  }
  
  .hero-badge {
    display: inline-flex;
    align-items: center;
    padding: 8px 20px;
    background: #f0f9ff;
    border: 1px solid #e0f2fe;
    border-radius: 100px;
    margin-bottom: 24px;
  }
  
  .hero-badge span {
    font-size: 0.875rem;
    font-weight: 600;
    color: #0369a1;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .hero-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: #1a1a1a;
    margin: 0 0 20px 0;
    letter-spacing: -0.02em;
  }
  
  .hero-description {
    font-size: 1.125rem;
    line-height: 1.7;
    color: #666666;
    margin: 0 0 32px 0;
  }
  
  .hero-stats {
    display: flex;
    gap: 40px;
    margin: 32px 0;
    padding: 24px 0;
    border-top: 1px solid #e5e5e5;
    border-bottom: 1px solid #e5e5e5;
  }
  
  .stat-item {
    text-align: left;
  }
  
  .stat-number {
    font-size: 1.75rem;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1;
    margin-bottom: 4px;
  }
  
  .stat-label {
    font-size: 0.875rem;
    color: #999999;
    font-weight: 500;
  }
  
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 32px;
  }
  
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    background: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 100px;
    font-size: 0.875rem;
    color: #666666;
    transition: all 0.2s ease;
  }
  
  .chip:hover {
    border-color: #0369a1;
    color: #0369a1;
    transform: translateY(-1px);
  }
  
  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  
  .hero-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .hero-media img {
    max-width: 100%;
    height: auto;
    filter: drop-shadow(0 20px 40px rgba(0,0,0,0.1));
  }
  
  /* Responsive */
  @media (max-width: 768px) {
    .hero-essentia {
      padding: 40px 0;
    }
    
    .hero-wrapper {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }
    
    .hero-content {
      max-width: 100%;
      margin: 0 auto;
    }
    
    .hero-stats {
      justify-content: center;
      gap: 30px;
    }
    
    .stat-item {
      text-align: center;
    }
    
    .hero-chips {
      justify-content: center;
    }
    
    .hero-actions {
      justify-content: center;
    }
    
    .hero-title {
      font-size: 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Velkommen" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Oppdag våre produkter" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop nå" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "hero_image", "label": "Background image" },
    { "type": "text", "id": "stat1_value", "label": "Stat 1 verdi", "default": "Nylig" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 label", "default": "Lansert" },
    { "type": "text", "id": "stat2_value", "label": "Stat 2 verdi", "default": "2" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 label", "default": "Bilprodukter" },
    { "type": "text", "id": "stat3_value", "label": "Stat 3 verdi", "default": "7" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 label", "default": "Dufter & refills" },
    { "type": "checkbox", "id": "show_video", "label": "Vis hero-video", "default": true },
    { "type": "checkbox", "id": "show_badge", "label": "Vis badge", "default": true },
    { "type": "text", "id": "badge_text", "label": "Badge-tekst", "default": "Premium Air Care" },
    { "type": "range", "id": "overlay_strength", "label": "Overlay styrke (0-100)", "min": 0, "max": 100, "step": 5, "default": 85 },
    { "type": "text", "id": "primary_label", "label": "Primærknapp", "default": "Bygg din pakke" },
    { "type": "url", "id": "primary_link", "label": "Primærlenke", "default": "#newsletter" },
    { "type": "text", "id": "secondary_label", "label": "Sekundærknapp", "default": "Se produkter" },
    { "type": "url", "id": "secondary_link", "label": "Sekundærlenke", "default": "/collections/all" }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Hero Chip",
      "settings": [
        { "type": "text", "id": "icon", "label": "Ikon/emoji", "default": "✨" },
        { "type": "text", "id": "label", "label": "Tekst", "default": "Lang varighet" }
      ]
    }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}