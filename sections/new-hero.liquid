<section style="padding: 60px 20px; background: #f8f9fa; min-height: 500px;">
  <div style="max-width: 1200px; margin: 0 auto;">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;">
      
      <!-- Innhold venstre -->
      <div>
        <div style="display: inline-block; padding: 8px 20px; background: #e3f2fd; border-radius: 20px; margin-bottom: 20px;">
          <span style="color: #1976d2; font-weight: 600; font-size: 14px; text-transform: uppercase;">
            {{ section.settings.badge_text }}
          </span>
        </div>
        
        <h1 style="font-size: 48px; font-weight: 700; color: #212121; margin: 0 0 20px 0; line-height: 1.1;">
          {{ section.settings.title }}
        </h1>
        
        <p style="font-size: 18px; color: #757575; line-height: 1.6; margin: 0 0 30px 0;">
          {{ section.settings.subtitle }}
        </p>
        
        <!-- Statistikk -->
        <div style="display: flex; gap: 40px; padding: 30px 0; border-top: 1px solid #e0e0e0; border-bottom: 1px solid #e0e0e0; margin: 30px 0;">
          <div>
            <div style="font-size: 28px; font-weight: 700; color: #212121;">{{ section.settings.stat1_value }}</div>
            <div style="font-size: 14px; color: #9e9e9e; margin-top: 4px;">{{ section.settings.stat1_label }}</div>
          </div>
          <div>
            <div style="font-size: 28px; font-weight: 700; color: #212121;">{{ section.settings.stat2_value }}</div>
            <div style="font-size: 14px; color: #9e9e9e; margin-top: 4px;">{{ section.settings.stat2_label }}</div>
          </div>
          <div>
            <div style="font-size: 28px; font-weight: 700; color: #212121;">{{ section.settings.stat3_value }}</div>
            <div style="font-size: 14px; color: #9e9e9e; margin-top: 4px;">{{ section.settings.stat3_label }}</div>
          </div>
        </div>
        
        <!-- Chips -->
        {% if section.blocks.size > 0 %}
        <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 30px;">
          {% for block in section.blocks %}
          <span style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: white; border: 1px solid #e0e0e0; border-radius: 20px; font-size: 14px;" {{ block.shopify_attributes }}>
            {{ block.settings.icon }} {{ block.settings.label }}
          </span>
          {% endfor %}
        </div>
        {% endif %}
        
        <!-- Knapper -->
        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <a href="{{ section.settings.primary_link }}" style="display: inline-block; padding: 14px 28px; background: #1976d2; color: white; text-decoration: none; border-radius: 30px; font-weight: 600;">
            {{ section.settings.primary_label }}
          </a>
          <a href="{{ section.settings.secondary_link }}" style="display: inline-block; padding: 14px 28px; background: white; color: #1976d2; text-decoration: none; border: 2px solid #e0e0e0; border-radius: 30px; font-weight: 600;">
            {{ section.settings.secondary_label }}
          </a>
        </div>
      </div>
      
      <!-- Bilde høyre -->
      <div style="display: flex; align-items: center; justify-content: center;">
        {% if section.settings.image %}
          <img src="{{ section.settings.image | img_url: 'master' }}" alt="{{ section.settings.title }}" style="max-width: 100%; height: auto;">
        {% else %}
          <div style="width: 100%; height: 400px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 20px; display: flex; align-items: center; justify-content: center;">
            <span style="color: white; font-size: 24px; font-weight: 600;">Produkt Bilde</span>
          </div>
        {% endif %}
      </div>
      
    </div>
  </div>
</section>

<!-- Mobil responsiv -->
<style>
  @media (max-width: 768px) {
    section > div > div {
      grid-template-columns: 1fr !important;
      text-align: center;
    }
    
    h1 {
      font-size: 32px !important;
    }
  }
</style>

{% schema %}
{
  "name": "New Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge tekst",
      "default": "Premium Air Care"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Tittel",
      "default": "Frisk luft, overalt"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Undertekst",
      "default": "Premium luftfriskere designet for moderne hjem og biler. Nordisk kvalitet møter innovativ teknologi."
    },
    {
      "type": "text",
      "id": "stat1_value",
      "label": "Statistikk 1 verdi",
      "default": "Nylig"
    },
    {
      "type": "text",
      "id": "stat1_label",
      "label": "Statistikk 1 label",
      "default": "Lansert"
    },
    {
      "type": "text",
      "id": "stat2_value",
      "label": "Statistikk 2 verdi",
      "default": "2"
    },
    {
      "type": "text",
      "id": "stat2_label",
      "label": "Statistikk 2 label",
      "default": "Bilprodukter"
    },
    {
      "type": "text",
      "id": "stat3_value",
      "label": "Statistikk 3 verdi",
      "default": "7"
    },
    {
      "type": "text",
      "id": "stat3_label",
      "label": "Statistikk 3 label",
      "default": "Dufter & refills"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primær knapp tekst",
      "default": "Bygg din pakke"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primær knapp lenke",
      "default": "#product-configurator"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Sekundær knapp tekst",
      "default": "Se produkter"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Sekundær knapp lenke",
      "default": "/collections/all"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero bilde"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Ikon (emoji)",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Lang varighet"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Hero",
      "blocks": [
        {
          "type": "chip",
          "settings": {
            "icon": "✨",
            "label": "Lang varighet"
          }
        },
        {
          "type": "chip",
          "settings": {
            "icon": "🌿",
            "label": "Naturlige dufter"
          }
        },
        {
          "type": "chip",
          "settings": {
            "icon": "♻️",
            "label": "Påfyllbar"
          }
        }
      ]
    }
  ]
}
{% endschema %}