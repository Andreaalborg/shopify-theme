<section id="newsletter" class="section newsletter-aurora" style="position:relative; z-index:10;">
  <div class="container">
    <div class="card" style="max-width:820px; margin:0 auto; overflow:hidden;">
      <div class="card-content" style="position:relative;">
        <div style="position:absolute; inset:-40% -20% auto auto; width:320px; height:320px; background:radial-gradient(closest-side, var(--accent), transparent); filter:blur(20px); opacity:.3; pointer-events:none;"></div>
        <div class="text-center" style="margin-bottom:16px;">
          <h2 style="margin:0 0 8px; color:var(--primary);">{{ section.settings.title | default: 'Aurora Newsletter' }}</h2>
          {% if section.settings.subtitle != blank %}
            <p style="margin:0; color:var(--text-muted);">{{ section.settings.subtitle }}</p>
          {% endif %}
        </div>

        <form action="/contact#contact_form" method="post" data-ajax="true" style="display:flex; gap:12px; flex-wrap:wrap; justify-content:center;">
          <input type="hidden" name="form_type" value="customer" />
          <input type="email" name="contact[email]" required inputmode="email" autocomplete="email" placeholder="Din e-postadresse" class="input" style="min-width:280px; flex:1; border:1px solid var(--border); border-radius:12px; padding:12px 14px;">
          <button type="submit" class="btn btn-primary">{{ section.settings.button_text | default: 'Meld meg på' }}</button>
          <input type="hidden" name="contact[tags]" value="newsletter, aurora" />
          <input type="hidden" name="contact[subject]" value="Aurora newsletter" />
          <input type="hidden" name="contact[body]" value="Ønsker å motta Aurora-nyhetsbrev" />
          <!-- Honeypot -->
          <input type="text" name="contact[website]" tabindex="-1" aria-hidden="true" style="position:absolute; left:-9999px; width:1px; height:1px;" />
        </form>

        <div class="nl-message" role="status" aria-live="polite" style="margin-top:10px; text-align:center; font-size:.95rem;"></div>

        {% if section.settings.privacy_note != blank %}
          <p class="text-center" style="margin-top:12px; font-size:0.9rem; color:var(--text-muted);">{{ section.settings.privacy_note }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  (function(){
    const root = document.currentScript && document.currentScript.previousElementSibling ? document.currentScript.previousElementSibling : document.querySelector('#newsletter');
    if(!root) return;
    const form = root.querySelector('form[data-ajax="true"]');
    const msg = root.querySelector('.nl-message');
    if(!form || !msg) return;

    function setMessage(text, ok){
      msg.textContent = text || '';
      msg.style.color = ok ? 'var(--primary)' : '#b00020';
    }

    form.addEventListener('submit', function(e){
      try {
        const hp = form.querySelector('input[name="contact[website]"]');
        if(hp && hp.value){ e.preventDefault(); return; }
        const email = form.querySelector('input[name="contact[email]"]').value.trim();
        const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if(!re.test(email)){
          e.preventDefault();
          setMessage('Vennligst skriv inn en gyldig e‑postadresse.', false);
          return;
        }
        if (form.dataset.ajax !== 'true') return;
        e.preventDefault();
        setMessage('Sender …', true);
        const fd = new FormData(form);
        fetch('/contact', { method: 'POST', body: fd, headers: { 'Accept': 'text/html' }})
          .then(function(res){
            if(res.ok){ setMessage('Takk! Du er nå påmeldt nyhetsbrevet.', true); form.reset(); }
            else { setMessage('Noe gikk galt. Prøv igjen.', false); }
          })
          .catch(function(){ setMessage('Kunne ikke sende nå. Sjekk nettet og prøv igjen.', false); });
      } catch(err){ /* stille fallback */ }
    });
  })();
  </script>

{% schema %}
{
  "name": "Aurora Newsletter",
  "settings": [
    { "type": "text", "id": "title", "label": "Tittel", "default": "Aurora Newsletter" },
    { "type": "textarea", "id": "subtitle", "label": "Undertittel", "default": "Eksklusive tips og tilbud – rett i innboksen." },
    { "type": "text", "id": "button_text", "label": "Knappetekst", "default": "Meld meg på" },
    { "type": "textarea", "id": "privacy_note", "label": "Personvern-note", "default": "1–2 e-poster i måneden. Du kan melde deg av når som helst." }
  ],
  "presets": [ { "name": "Aurora Newsletter" } ]
}
{% endschema %}


