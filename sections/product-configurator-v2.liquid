    },
    {
      "type": "product",
      "id": "oil_3",
      "label": "Duft 3"
    },
    {
      "type": "product",
      "id": "oil_4",
      "label": "Duft 4"
    },
    {
      "type": "product",
      "id": "oil_5",
      "label": "Duft 5"
    },
    {
      "type": "product",
      "id": "oil_6",
      "label": "Duft 6"
    },
